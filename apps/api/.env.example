# Copy to ~/.rcd-control/.env (mode 600). Replace every placeholder; never commit real values.
MAC_CONTROL_PORT=<PORT>
MAC_CONTROL_HOST=<LOOPBACK_HOST>
MAC_CONTROL_LOG_LEVEL=<LOG_LEVEL>
MAC_CONTROL_ORGANIZATION_NAME=<ORGANIZATION_NAME>
MAC_CONTROL_PRODUCT_NAME=<PRODUCT_NAME>
MAC_CONTROL_PRODUCT_SHORT_NAME=<PRODUCT_SHORT_NAME>

# Read-only sources use the existing gh login; no token is needed here.
MAC_CONTROL_GH_PATH=<PATH_TO_GH>
MAC_CONTROL_OPS_REPORTS_DIR=<PATH_TO_REPORTS_DIRECTORY>

# Optional Hermes archive; both variables already support environment configuration.
# MAC_CONTROL_HERMES_REPORTS_DIR=/srv/dashboard/hermes-archive
# Default reports follow MAC_CONTROL_DATA_DIR/reports; omit OPS_REPORTS_DIR to use it.
# Each service needs a separate runtime, e.g. /srv/dashboard/mcd-runtime or rcd-runtime.
# MAC_CONTROL_DATA_DIR=/srv/dashboard/mcd-runtime
# Additional dedicated folders operators may choose in Settings/setup/Ops reports:
# MAC_CONTROL_REPORTS_ALLOWED_ROOTS='["/srv/dashboard/report-output"]'

# Managed updates (packaged installs only; see packaging/README.md). Unset = manual updates.
# MAC_CONTROL_UPDATE_ROOT=/srv/dashboard/install

# SEC-013: exact reviewed routes; unknown pricing denies before spawn.
# Values are free, subscription or paid. Paid routes require a runtime dollar cap.
# MAC_CONTROL_DISPATCH_ROUTE_CLASSES='{"openclaw|synthetic-worker|synthetic-model":"free"}'
# MAC_CONTROL_DISPATCH_FREE_ONLY=true
# MAC_CONTROL_DISPATCH_MAX_BUDGET_USD=0
# MAC_CONTROL_DEFAULT_BUDGET_USD=0

# External-action guard: retain false until separately reviewed deployment.
# This switch grants no action authorization; each write still needs an exact human approval.
# MAC_CONTROL_GITHUB_WRITES_ENABLED=false
