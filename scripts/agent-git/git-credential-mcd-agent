#!/bin/bash
# git credential helper for MCD project agents.
# Serves the agent token ONLY for the two public MCD/RCD repositories, over HTTPS.
# Requires credential.useHttpPath=true so the repository path is part of the request.
# The token file is operator-owned: ~/.rcd-control/agent-git/token (mode 600). Never printed.
set -u
[ "${1:-}" = "get" ] || exit 0
host=""; path=""; protocol=""
while IFS='=' read -r key value; do
  case "$key" in host) host="$value";; path) path="$value";; protocol) protocol="$value";; esac
done
[ "$protocol" = "https" ] && [ "$host" = "github.com" ] || exit 0
case "$path" in
  gptkiosk/mac-control-dashboard|gptkiosk/mac-control-dashboard.git|\
  gptkiosk/rbp-control-dashboard|gptkiosk/rbp-control-dashboard.git) ;;
  *) exit 0 ;;
esac
token_file="${MCD_AGENT_GIT_TOKEN_FILE:-$HOME/.rcd-control/agent-git/token}"
[ -r "$token_file" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$(head -n 1 "$token_file")"
